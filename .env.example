# LLM provider: openai (default), azure, openai-compatible
MODEL_PROVIDER=openai

# Common model setting (provider specific)
MODEL=gpt-4o

# OpenAI provider
OPENAI_API_KEY=your_openai_api_key_here

# Azure OpenAI provider
#AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
#AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
#AZURE_OPENAI_DEPLOYMENT=your_deployment_name
#AZURE_OPENAI_API_VERSION=2024-02-15-preview

# OpenAI-compatible provider
#OPENAI_BASE_URL=https://api.example.com/openai/v1
#OPENAI_COMPATIBLE_BASE_URL=https://api.example.com/openai/v1
#OPENAI_COMPATIBLE_API_KEY=your_compatible_api_key_here

# Optional API key source: env (default) or oauth2
#OPENAI_API_KEY_PROVIDER=oauth2
#OAUTH_TOKEN_URL=https://auth.example.com/oauth/token
#OAUTH_CLIENT_ID=your_client_id
#OAUTH_CLIENT_SECRET=your_client_secret
